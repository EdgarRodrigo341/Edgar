
print("=== Convertidor de Temperatura ===")

celsius = float(input("Ingrese los grados Celsius: "))

print("1. Fahrenheit")
print("2. Kelvin")

opcion = input("Seleccione una opción: ")

match opcion:
    case "1":
        fahrenheit = (celsius * 9/5) + 32
        print("Resultado:", round(fahrenheit, 2), "°F")
    case "2":
        kelvin = celsius + 273.15
        print("Resultado:", round(kelvin, 2), "K")
    case _:
        print("Opción no válida.")
