
positivos = 0
negativos = 0
ceros = 0

cantidad = int(input("¿Cuántos números desea ingresar?: "))

for i in range(cantidad):
    num = int(input("Ingrese un número: "))

    if num > 0:
        positivos += 1
    elif num < 0:
        negativos += 1
    else:
        ceros += 1

print("\nResultados")
print("Positivos:", positivos)
print("Negativos:", negativos)
print("Ceros:", ceros)
