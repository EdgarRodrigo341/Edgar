
suma = 0
cantidad = 0

print("Ingrese números positivos. Un número negativo termina el programa.")

while True:
    numero = float(input("Número: "))

    if numero < 0:
        break

    suma += numero
    cantidad += 1

if cantidad > 0:
    media = suma / cantidad
    print("La media es:", media)
else:
    print("No se ingresaron números positivos.")
